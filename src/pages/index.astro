---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Field from '../components/Field.astro';
import Approach from '../components/Approach.astro';
import Team from '../components/Team.astro';
import Network from '../components/Network.astro';
import Rates from '../components/Rates.astro';
import Contact from '../components/Contact.astro';
import { organization } from '../lib/jsonld';
import { href } from '../lib/util';

const jsonld = await organization(Astro.site!, href());
---
<Base jsonld={jsonld}>
  <main id="top">
    <Hero />
    <Field />
    <Approach />
    <Team />
    <Network />
    <Rates />
    <Contact />
  </main>
</Base>
