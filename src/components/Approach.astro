---
import { Image } from 'astro:assets';
import SectionLabel from './SectionLabel.astro';
import { section } from '../lib/content';
import { image } from '../lib/util';
const { data } = await section('approach');
---
<section class="block tint" id={data.id}>
  <div class="wrap cols">
    <SectionLabel order={data.order} title={data.title} />
    <div>
      <p class="intro">{data.intro}</p>
      <ol class="steps">
        {data.steps.map((s, i) => (
          <li>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <div class="text">
              <h3>{s.title}</h3>
              <p class="sub">{s.subtitle}</p>
              <p class="body">{s.body}</p>
            </div>
            {s.image && (
              <Image class="mood" src={image(s.image.file)} alt={s.image.alt} width={800} height={600} fit="cover"
                widths={[400, 800]} sizes="(max-width: 900px) calc(100vw - 2.5rem), 22rem" />
            )}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
