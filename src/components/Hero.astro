---
import { Image } from 'astro:assets';
import { section } from '../lib/content';
import { site } from '../lib/site';
import { image, mailto } from '../lib/util';
const { data } = await section('hero');
---
<section class:list={['hero', { cover: data.image }]}>
  {data.image ? (
    <div class="wall">
      <Image class="bleed" src={image(data.image.file)} alt={data.image.alt} widths={[800, 1376]} sizes="100vw"
        loading="eager" fetchpriority="high" />
      <div class="wrap">
        <h1 class="painted">{data.headline.map((line) => <span>{line}</span>)}</h1>
      </div>
    </div>
  ) : (
    <div class="wrap">
      <h1>{data.headline.map((line) => <span>{line}</span>)}</h1>
    </div>
  )}
  <div class="wrap">
    <div class="foot">
      <p>{data.subline}</p>
      <a class="cta solid" href={mailto(site.email, site.cta.subject)}>{data.cta}</a>
    </div>
  </div>
</section>
