---
import SectionLabel from './SectionLabel.astro';
import { section } from '../lib/content';
const { data, Content } = await section('field');
---
<section class="block" id={data.id}>
  <div class="wrap cols">
    <SectionLabel order={data.order} title={data.title} />
    <div>
      <div class="lead"><Content /></div>
      <div class="two">
        {data.segments.map((s) => <div><h3>{s.title}</h3><p>{s.body}</p></div>)}
      </div>
    </div>
  </div>
</section>
