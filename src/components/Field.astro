---
import { Image } from 'astro:assets';
import SectionLabel from './SectionLabel.astro';
import { section } from '../lib/content';
import { image } from '../lib/util';
const { data, Content } = await section('field');
---
<section class="block" id={data.id}>
  <div class="wrap cols">
    <SectionLabel order={data.order} title={data.title} />
    <div>
      <div class="lead"><Content /></div>
      <div class="two">
        {data.segments.map((s) => (
          <div>
            {s.image && (
              <Image class="mood" src={image(s.image.file)} alt={s.image.alt} width={800} height={600} fit="cover"
                widths={[400, 800]} sizes="(max-width: 760px) calc(100vw - 2.5rem), 28rem" />
            )}
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
