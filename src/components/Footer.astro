---
import Logo from './Logo.astro';
import { site } from '../lib/site';
import { href, linkLabel } from '../lib/util';

const credit = site.credit.replace('{year}', String(new Date().getFullYear()));
---
<footer>
  <div class="wrap">
    <div>
      <Logo />
      <p>{site.address.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
      <p class="credit">{credit}</p>
    </div>
    <div>
      <p>{site.labels.cvr} {site.cvr}</p>
      <p><a href={site.linkedin}>{linkLabel(site.linkedin)}</a></p>
      <p><a href={href('privacy/')}>{site.labels.privacy}</a></p>
    </div>
  </div>
</footer>
